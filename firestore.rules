rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isAdmin() {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.active == true;
    }

    // 1. Admins Collection
    // Only authenticated admins can read their own admin doc or admin list, and only existing active admins can write
    match /admins/{adminUid} {
      allow get: if isSignedIn() && (request.auth.uid == adminUid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // 2. Categories Collection
    // Public read, Admin-only write
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 3. Products Collection
    // Public read for published, Admin read for all; Admin-only create, update, delete
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 4. Games Collection
    // Public read, Admin-only write
    match /games/{gameId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 5. Portfolio Projects & Skills
    match /portfolioProjects/{projectId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /portfolioSkills/{skillId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 6. Audit Logs
    // Admin only can read and create audit logs
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit logs
    }

    // 7. Orders Collection
    match /orders/{orderId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow create: if true;
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // 8. Reviews Collection
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
    }

    // 9. Site Configuration
    match /siteConfig/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // 10. Users Profiles
    match /users/{userId} {
      allow read: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow write: if isSignedIn() && request.auth.uid == userId;
    }
  }
}
